 "poems": [
  {
   "seq": "1",
   "text": "たなはたの心のうちのあらはれて人まちかほに見ゆる空哉",
   "kana": "",
   "speaker": "從三位藤原爲理",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "七夕はあかすや猶もいそくらんくれやすき日も心つくしに",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "たなはたのなとはつ秋と契りけん月のよさむの比をわすれて",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "織女のとほきわたりの朝霞はれぬ思ひの名にや立らん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "七夕のまちこしよひもちかつきて荻のうら葉に風わたるなり",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "あふ事のさはりやせんと七夕の心さはかす宵のむら雲",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "たなはたのなみたほすへきこよひたに猶袖ぬらす秋の村雨",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "棚機の秋の契りは草の葉の露とゝもにやむすひをきけん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "逢とのまれなる中もかはらねは心へたつなあまの川霧",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "久かたのあまつ星合にたむくれはけにそら燒の煙とそ見む",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "涙こそあまのかはともなりぬらめあふを稀なる中に流て",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "さよふくる天の河原のいは枕かさぬる袖も涼しかるらむ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "銀河こそのあさせやたのむらんかはらぬ中の心ならひに",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "七夕のなに賴みけんあふ事はやすのわたりの名のみんけり",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "行末は又こそ年をこゆるきのいそかてたのめけふの星合",
   "kana": "",
   "speaker": "七夕七十首",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "波たては八十のふな津に舟留てやすらふほとに夜や更ぬらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "住のえのたねにはあらて天の河わすれぬ草や岸にをふらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "あすよりはあまの河波こしかたに又立かへり物や思はん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "七夕もやとりやすらむ久かたの中なる里の名をたのみつゝ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "七夕の今宵はかりやちりつもるゆかのあたりをうち拂ふらん",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "織女の心なからのはし〓〓〓ああたまる世もなき契かな",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "なみこゆる水かけ草の末葉こそみらく少なきたくひなるらめ",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "けふをまつ心をとへはかちの葉に我思ふ〓そそつかゝれける",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "まちわたるあふせそとをき鵠の羽をならふる契りなれとも",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "袖うすきまたはつ秋の星合にかすともうけし鶴の毛衣",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "あけぬともしはしはみまく星合の空にきこえぬ鳥の音もかな",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "あし分るみちとはきかすこよひたにさはらてわたせ天の川舟",
   "kana": "",
   "speaker": "",
   "page": 519,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "かちの音ほのかにきこゆひ、ほしの妻むかへ舟今かこくらし",
   "kana": "",
   "speaker": "七夕七十首",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "こく舟のかひのしつくもあるきまて袖に露をく星台の空",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "あかてこそ立かへるらめさす棹のしつくにのこる天ノ川波",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "七夕の五百機たてゝおりしもあれおなし秋まつ虫の聲かな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "秋をへてけふかす糸のひとすちに絕えぬをなかき契とそ見る",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "七夕のうすき衣にたちぬはむけふの細布今日をまちえて",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "まとをなる天のは衣しるらめや〓やく浦にたくひ有とは",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "織女のひと夜はかりの契ゆへうきになれゆく袖の秋風",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "今宵まつ七夕つめのあまつひれふりきけみれはふくる空哉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "ひこほしに今宵あはんと七夕のあかもたれ引時は來にけり",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "下ひものとけてぬる夜のなきまゝにあかてやたえぬ星合の空",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "秋をまつ七夕つめのたまかつら思ひもたえしかけもはなれす",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "棚機のあかぬなみたをかげそへてかさしにあまる露の白玉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "七夕のあはぬ月日はおほぬさのひくてあまたにならぬ計そ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "七夕にたむくるとのしらへさへ秋のこゑにやこよひあふらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "天目!へさの舟はわたし守やすらひにこそよすへかりけれ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "七夕の又こむほとは遠けれと賴みありてや起わかるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "天の河わたす紅葉のくれなゐに涙もさこそ色かはるらめ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "七夕の雲のよそなるかけはかりほのかにみてもそふ思ひかな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "人しれぬ心はかさし七夕のしのはゝいとゝ物や思はん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "いかにせむ我身はせめて七夕のひさしき程の契たになし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "銀漢たなはたつめに〓とはむあふもかたのゝつらきわたりを",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "たなはたの心のうちやかよふとて我おもふ〓とを祈りつる哉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "七夕のなかきためしにちかはすは志はしまをゝ賴まれやせん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "七夕をかけてはいはし逢〓とのたえぬ計はたのみなれとも",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "牽牛のゆきあふ空をよそにみて我まつかたは更にける哉",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "今宵とて身にはいとはす七夕の久しきほともならひなけれは",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "七夕のわかるゝ空のきぬ〓〓はたかくたにかる淚なるらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "あふといへと今夜はかりの契りにて又一とせのすゑそ久しき",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "七夕は稀にあふよもたのむらん心なかさは我そまされる",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "うき中は思ひたえてもあられけりなと七夕をよそにみつらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "うき人もおもひいつやとまたれつる契よそなる星あひの空",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "七夕は行末まても賴むらんなとあたし世になさけのこさぬ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "雲の上は星の宿りのちかけれはおもかけかよふ庭のともし火",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "草枕たひね露けき袖のうへにみやこにゝたる星合の空",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "七夕も逢よになりぬ今よりのみ山の秋にいかてたへまし",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "野風ふくかり庵さむし七夕の秋さり衣我にかさなむ",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "天河かよふ道とはきかねともしほせのあまも舟やかすらん",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "ほし合を雲井になれてみし秋はなをほと近きこゝちせしかな",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "ほし合の影をはいかてうつさましさのみしつめる水の鏡に",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "七夕のまれの契りは名のみしてつきぬまとのさとりとそきく",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "世をてらす神の御代よりたえしとそ契りやをきし天津七夕",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "世中にたえぬためしをたつぬれは我君か代に星あひの空",
   "kana": "",
   "speaker": "",
   "page": 520,
   "pid": "1879496",
   "form": "短歌",
   "genre": ""
  }
 ],
